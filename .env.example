# ============================================================================
#  Penyimpanan permanen: Supabase (WAJIB untuk Vercel)
# ----------------------------------------------------------------------------
#  1. Buat project di https://supabase.com
#  2. Buka SQL Editor -> jalankan seluruh isi file `supabase/schema.sql`
#  3. Buka Project Settings -> API Keys -> salin "service_role" / secret key
#  4. Isi nilainya di bawah (lokal: file .env | Vercel: Settings -> Environment Variables)
#
#  PENTING:
#   - Gunakan SERVICE ROLE KEY, bukan anon/publishable key. RLS menolak semua
#     akses dari anon key sehingga data soal & jawaban tidak bisa dibaca publik.
#   - Kunci ini hanya dibaca server (Express / Vercel Function). Jangan pernah
#     memakai prefix NEXT_PUBLIC_ / VITE_ untuk service role key.
# ============================================================================
SUPABASE_URL="https://xxxxxxxxxxxx.supabase.co"
SUPABASE_SERVICE_ROLE_KEY="service-role-key-dari-dashboard-supabase"

# Opsional: interval penyegaran cache in-memory dari Supabase (milidetik).
# Default 10000 (10 detik). Di Vercel refresh dilakukan per request (throttled).
SUPABASE_REFRESH_MS="10000"

# GEMINI_API_KEY: Required for Gemini AI API calls (penilaian esai otomatis).
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: URL publik aplikasi (dipakai untuk link self-referential).
APP_URL="MY_APP_URL"

# CLOUDFLARE_D1: Opsional, integrasi database Cloudflare D1 (legacy).
# Penyimpanan utama sekarang Supabase; D1 tetap bisa dipakai sebagai backup.
CLOUDFLARE_ENABLED="false"
CLOUDFLARE_MODE="D1_DIRECT"
CLOUDFLARE_ACCOUNT_ID=""
CLOUDFLARE_DATABASE_ID=""
CLOUDFLARE_API_TOKEN=""
CLOUDFLARE_WORKER_URL=""
CLOUDFLARE_WORKER_SECRET=""
